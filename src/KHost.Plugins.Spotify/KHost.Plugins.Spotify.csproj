<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Windows target exists only for Windows.Media.Control, which is how this plugin reads
         Spotify's transport back on Windows; macOS and Linux read theirs through AppleScript and
         MPRIS and need nothing extra. Everything else builds the plain target. -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.6</Version>
  </PropertyGroup>

  <!-- The Windows target needs its reference pack resolved explicitly off Windows, or the whole
       build fails NETSDK1100 - including the plain target, which has nothing to do with it. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS_MEDIA_SESSION</DefineConstants>
    <!-- The host is a plain net10.0 process, so it carries no WinRT projection of its own. A
         plugin folder that does not ship one loads fine and then throws FileNotFoundException the
         first time the media session is read. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- The published contracts, not a sibling checkout: this repo used to fail to build whenever
         the KHost checkout beside it changed branch, and an outside author has no such checkout at
         all. The package's own targets keep them out of this project's output, so nothing
         downstream loses them. Both are MIT, so no PolyForm code reaches what this redistributes. -->
    <PackageReference Include="KHost.Abstractions" Version="0.49.0" />
    <PackageReference Include="KHost.Common" Version="0.49.0" />

    <!-- Came in through KHost.Plugins.Sdk before it was folded into Abstractions, which declares
         contracts and takes no packages of its own. The host has this loaded, so a shipped copy
         is never the one used. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The provider's controller seam is internal: ActivatorUtilities must not see a constructor
         the host cannot supply, but the tests need one to inject a fake backend into. -->
    <InternalsVisibleTo Include="KHost.Plugins.Spotify.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

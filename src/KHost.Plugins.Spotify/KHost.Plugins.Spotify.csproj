<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Windows target exists only for Windows.Media.Control, which is how this plugin reads
         Spotify's transport back on Windows; macOS and Linux read theirs through AppleScript and
         MPRIS and need nothing extra. Everything else builds the plain target. -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The Windows target needs its reference pack resolved explicitly off Windows, or the whole
       build fails NETSDK1100 - including the plain target, which has nothing to do with it. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS_MEDIA_SESSION</DefineConstants>
    <!-- The host is a plain net10.0 process, so it carries no WinRT projection of its own. A
         plugin folder that does not ship one loads fine and then throws FileNotFoundException the
         first time the media session is read. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- One build reaches the host's plugins folder, not both: the two targets write the same file
       names, so deploying each in turn would leave whichever finished last. -->
  <PropertyGroup>
    <_DeployTargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</_DeployTargetFramework>
    <_DeployTargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</_DeployTargetFramework>
    <_KHostOutputDir>$(MSBuildProjectDirectory)\..\..\..\KHost\src\KHost.UserInterface\bin\Debug\net10.0</_KHostOutputDir>
    <_PluginDeployDir>$(_KHostOutputDir)\plugins\khost.spotify</_PluginDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sibling checkout of the KHost repo; swap for the KHost.Plugins.Sdk NuGet package once published. -->
    <ProjectReference Include="..\..\..\KHost\src\KHost.Plugins.Sdk\KHost.Plugins.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The provider's controller seam is internal: ActivatorUtilities must not see a constructor
         the host cannot supply, but the tests need one to inject a fake backend into. -->
    <InternalsVisibleTo Include="KHost.Plugins.Spotify.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Dev convenience: drop the built plugin into a sibling KHost checkout's runtime plugins
       folder when one exists. Harmless no-op anywhere else. -->
  <Target Name="DeployToSiblingKHost" AfterTargets="Build"
          Condition="Exists('$(_KHostOutputDir)') And '$(TargetFramework)' == '$(_DeployTargetFramework)'">
    <ItemGroup>
      <!-- Globbed inside the target so it sees what is on disk now, not at evaluation. -->
      <_StalePluginFiles Include="$(_PluginDeployDir)\**\*" />
      <_PluginFiles Include="$(TargetDir)**\*" />
    </ItemGroup>

    <!-- Emptied first, because a copy only overwrites what it brings: renaming the assembly or
         dropping a reference otherwise leaves the old file beside the new one, and the folder
         stops matching what the build produced. It also keeps the two target frameworks from
         layering, since only one of them ships the WinRT projection. ContinueOnError so a running
         KHost, which holds every loaded plugin assembly mapped on Windows, fails on the copy below
         with a message that names the locking process instead of here with a bare delete error. -->
    <Delete Files="@(_StalePluginFiles)" ContinueOnError="true" />

    <Copy SourceFiles="@(_PluginFiles)"
          DestinationFiles="@(_PluginFiles->'$(_PluginDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
